# Discord Developer Portal → Bot page
DISCORD_TOKEN=replace_with_your_bot_token
# Enable Developer Mode in Discord, then right-click to copy IDs.
GUILD_ID=your_server_id
GUARD_CHANNEL_ID=your_guard_request_channel_id
# Comma-separated role IDs. Every member with one of these roles receives test-result approvals by DM.
APPROVER_ROLE_IDS=role_id_1,role_id_2
# Optional: send test requests to an operations channel as well.
TEST_REQUEST_CHANNEL_ID=
